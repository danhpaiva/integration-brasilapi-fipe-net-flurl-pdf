<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Auto Premium FIPE</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow-sm mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Fipe" asp-action="Index">
                    <i class="bi bi-car-front-fill"></i> Auto Premium
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-3 px-3 px-md-0">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-5 bg-white py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Integration BrasilAPI Fipe - <span class="badge bg-secondary">Senior Dev Mode</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>