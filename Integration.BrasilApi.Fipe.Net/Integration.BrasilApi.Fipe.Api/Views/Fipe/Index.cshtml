@{
    ViewData["Title"] = "Consulta FIPE";
}

<div class="text-center">
    <h1 class="display-4">Consultar Preço FIPE</h1>
    <p>Insira o código para gerar a avaliação em PDF.</p>

    <form asp-action="Detalhes" method="post" class="mt-4">
        <div class="input-group mb-3" style="max-width: 400px; margin: 0 auto;">
            <input type="text" name="codigoFipe" class="form-control" placeholder="Ex: 001004-9" required>
            <button class="btn btn-primary" type="submit">Consultar</button>
        </div>
    </form>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.ErrorMessage</div>
    }
</div>