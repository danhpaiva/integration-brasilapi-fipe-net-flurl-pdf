@model Integration.BrasilApi.Fipe.Domain.Models.VeiculoFipeResponse

@{
    ViewData["Title"] = "Avaliação de Veículo";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white">
            <h3 class="mb-0">Resultado da Consulta FIPE</h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Marca:</strong> @Model.Marca</p>
                    <p><strong>Modelo:</strong> @Model.Modelo</p>
                    <p><strong>Ano/Modelo:</strong> @Model.AnoModelo</p>
                    <p><strong>Combustível:</strong> @Model.Combustivel (@Model.SiglaCombustivel)</p>
                </div>
                <div class="col-md-6 border-start">
                    <h4 class="text-primary">Preço Médio: @Model.Valor</h4>
                    <p class="text-muted">Referência: @Model.MesReferencia</p>
                    <p class="small text-secondary">Código FIPE: @Model.CodigoFipe</p>
                </div>
            </div>

            <div class="alert alert-success mt-4">
                <i class="bi bi-file-earmark-pdf"></i>
                Um relatório PDF detalhado foi gerado e salvo na sua área de trabalho.
            </div>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-outline-secondary">Nova Consulta</a>
        </div>
    </div>
</div>